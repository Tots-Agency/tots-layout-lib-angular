{
  "name": "tots-layout-angular",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build2": "ng build --project=@tots/layout --configuration production && cd dist/tots/layout/ && npm publish --access public",
    "build3": "ng build --project=@tots/confirm-modal --configuration production && cd dist/tots/confirm-modal/ && npm publish --access public",
    "build4": "ng build --project=@tots/crud-page --configuration production && cd dist/tots/crud-page/ && npm publish --access public",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/platform-browser-dynamic": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@tots/cloud-storage": "^20.0.0",
    "@tots/core": "^21.0.0",
    "@tots/filter-box": "^20.0.0",
    "@tots/filter-menu": "^20.0.0",
    "@tots/form": "^20.0.0",
    "@tots/loading": "^20.0.0",
    "@tots/table": "^20.0.0",
    "@tots/users-selector-menu": "^20.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.8.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.25",
    "@types/jasmine": "~4.0.0",
    "jasmine-core": "~4.3.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.0.0",
    "ng-packagr": "^21.2.7",
    "typescript": "~5.9.3"
  }
}
